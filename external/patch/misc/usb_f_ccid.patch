diff --git a/drivers/usb/gadget/function/Kconfig b/drivers/usb/gadget/function/Kconfig
index 2876939..8c71cc5 100644
--- a/drivers/usb/gadget/function/Kconfig
+++ b/drivers/usb/gadget/function/Kconfig
@@ -124,6 +124,16 @@ config USB_F_HID
 	tristate
 	select USB_F_HID_LEGACY if USB_F_HID=y && USB_ETH_RNDIS
 
+config USB_F_CCID
+	tristate "USB Chip Card Interface Device (CCID)"
+	help
+	  The CCID function driver provides a USB Chip Card Interface Device.
+	  It can be used to emulate a smart card reader.
+
+	  Say "y" to link the driver statically, or "m" to build it as
+	  a module (f_ccid).
+
 config USB_F_PRINTER
 	tristate
 
